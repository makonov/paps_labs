    {
      "name": "Успешное получение существующей конференции",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус ответа 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Типы данных корректные\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.id).to.be.a(\"number\");\r",
              "    pm.expect(jsonData.name).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.startDate).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.endDate).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.location).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Данные соответствуют сид-данным\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.id).to.equal(1);\r",
              "    pm.expect(jsonData.name).to.equal(\"DevConf Spring 2026\");\r",
              "    pm.expect(jsonData.startDate).to.equal(\"2026-04-15\");\r",
              "    pm.expect(jsonData.endDate).to.equal(\"2026-04-17\");\r",
              "    pm.expect(jsonData.location).to.equal(\"Санкт-Петербург\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
