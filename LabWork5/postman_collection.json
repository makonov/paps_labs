    {
      "name": "Успешное создание конференции",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус ответа 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"В ответе есть сгенерированный id\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"id\");\r",
              "    pm.expect(jsonData.id).to.be.a(\"number\").and.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Возвращённые данные совпадают с отправленными\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.name).to.equal(\"Конференция Осень 2026\");\r",
              "    pm.expect(jsonData.startDate).to.equal(\"2026-09-10\");\r",
              "    pm.expect(jsonData.endDate).to.equal(\"2026-09-12\");\r",
              "    pm.expect(jsonData.location).to.equal(\"Екатеринбург\");\r",
              "});\r",
              "\r",
              "// Сохраняем id новой конференции для следующих тестов\r",
              "pm.environment.set(\"last_conference_id\", pm.response.json().id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
